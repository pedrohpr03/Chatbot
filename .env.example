# Credenciais da API do Spotify
# 1. Acesse https://developer.spotify.com/dashboard
# 2. Crie um app (Client Credentials) e copie o Client ID e Client Secret
# 3. Renomeie este arquivo para .env e preencha os valores abaixo

SPOTIFY_CLIENT_ID=seu_client_id_aqui
SPOTIFY_CLIENT_SECRET=seu_client_secret_aqui

# Token da Inference API do HuggingFace (LLM de conversa)
# 1. Crie uma conta em https://huggingface.co
# 2. Gere um token (Read) em https://huggingface.co/settings/tokens
# 3. Cole abaixo
HF_TOKEN=seu_token_huggingface_aqui

# Token de acesso da API do Genius (busca de LETRAS de música)
# 1. Crie uma conta em https://genius.com
# 2. Crie um app em https://genius.com/api-clients e copie o "Client Access Token"
# 3. Cole abaixo. Sem ele, o bot apenas não responde letras (cai no fallback).
GENIUS_ACCESS_TOKEN=seu_token_genius_aqui
